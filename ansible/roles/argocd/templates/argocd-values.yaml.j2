global:
  # Ist argocd_ui_host gesetzt, leitet das Chart daraus auch configs.cm.url ab (Links, SSO-Callbacks).
  domain: {{ argocd_ui_host | default('argocd.' ~ hostname, true) }}

server:
  insecure: {{ argocd_server_insecure | lower }}
  service:
    type: NodePort
    # Beide NodePorts sprechen wegen server.insecure Klartext-HTTP (https://...:30443 wird zurueckgesetzt).
    # 30080 dient CLI und CI; die Web-UI laeuft per HTTPS ueber den Ingress unten.
    nodePortHttp: 30080
    nodePortHttps: 30443
{% if argocd_ingress_enabled | bool %}
  # HTTPS-Ingress ueber Traefik (internes Wildcard-Zertifikat, Host steht in
  # argocd/apps/tech/cert-manager/templates/certificate-homeserver-wildcard.yaml). Der Server
  # laeuft insecure, TLS endet im Traefik - wie bei allen anderen Apps. Als Wert in der Rolle,
  # damit der taegliche Semaphore-Lauf (helm upgrade) ihn nicht zurueckdreht.
  ingress:
    enabled: true
    ingressClassName: traefik
    hostname: {{ argocd_ui_host }}
    tls: false
{% endif %}

configs:
  cm:
{% if argocd_ci_account_enabled | bool %}
    # Konto fuer die Promotion-Kette (GitHub Actions): nur API-Token, kein Passwort-Login.
    accounts.ci: apiKey
{% endif %}
    # Eigene DaemonSet-Gesundheitspruefung (siehe Kommentar im Skript): node-exporter ausgenommen.
    resource.customizations.health.apps_DaemonSet: |
      local hs = {}
      -- node-exporter laeuft absichtlich auch auf den per Wake-on-LAN geschalteten Workern (oft aus):
      -- der DaemonSet ist dauerhaft "nicht vollstaendig bereit" und blockierte damit jeden Sync von `monitoring`
      -- (Operation lief 4 Tage lang, 2026-09-15 bis 2026-09-19). Gesundheit hier ignorieren.
      if obj.metadata.name == "monitoring-prometheus-node-exporter" then
        hs.status = "Healthy"
        hs.message = "Gesundheit ignoriert: laeuft absichtlich auch auf ausgeschalteten Workern"
        return hs
      end
      -- Standardverhalten von ArgoCD fuer alle anderen DaemonSets (kein string.format: die Lua-Sandbox von ArgoCD hat keine string-Bibliothek)
      if obj.status == nil then
        hs.status = "Progressing"
        hs.message = "Waiting for status"
        return hs
      end
      if obj.metadata.generation ~= nil and obj.status.observedGeneration ~= nil and obj.metadata.generation > obj.status.observedGeneration then
        hs.status = "Progressing"
        hs.message = "Waiting for rollout to finish: observed daemon set generation less than desired generation"
        return hs
      end
      local desired = obj.status.desiredNumberScheduled or 0
      if obj.spec ~= nil and obj.spec.updateStrategy ~= nil and obj.spec.updateStrategy.type == "OnDelete" then
        hs.status = "Healthy"
        hs.message = tostring(obj.status.numberAvailable or 0) .. " of " .. tostring(desired) .. " updated pods are available"
        return hs
      end
      if (obj.status.updatedNumberScheduled or 0) < desired then
        hs.status = "Progressing"
        hs.message = "Waiting for daemon set " .. obj.metadata.name .. " rollout to finish: " .. tostring(obj.status.updatedNumberScheduled or 0) .. " out of " .. tostring(desired) .. " new pods have been updated..."
        return hs
      end
      if (obj.status.numberAvailable or 0) < desired then
        hs.status = "Progressing"
        hs.message = "Waiting for daemon set " .. obj.metadata.name .. " rollout to finish: " .. tostring(obj.status.numberAvailable or 0) .. " of " .. tostring(desired) .. " updated pods are available..."
        return hs
      end
      hs.status = "Healthy"
      hs.message = tostring(obj.status.numberAvailable or 0) .. " of " .. tostring(desired) .. " updated pods are available"
      return hs
{% if argocd_ci_account_enabled | bool %}
  rbac:
    # Das Konto `ci` darf Applications nur lesen (eingebaute Rolle role:readonly).
    policy.csv: |
      g, ci, role:readonly
{% endif %}
  params:
    server.insecure: "{{ argocd_server_insecure | lower }}"

redis-ha:
  enabled: false

controller:
  replicas: 1

repoServer:
  replicas: 1

applicationSet:
  replicas: 1
