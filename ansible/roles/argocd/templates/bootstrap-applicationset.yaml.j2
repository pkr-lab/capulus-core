# Single source of truth for the bootstrap ApplicationSets.
# The committed copy at argocd/bootstrap/root-applicationset.yaml is GENERATED
# from this template — run `make render-bootstrap` after editing this file or
# the argocd_repo_* / argocd_namespace vars in group_vars. Do not hand-edit the
# committed copy.
#
# Apps live under argocd/apps/platform/<app> or argocd/apps/workloads/<app>
# (see docs/b-kubernetes-gitops/b0020-argocd-projects.md) — each app keeps its own namespace
# (destination.namespace is still just the app's basename, unaffected by the
# directory nesting). Two SEPARATE ApplicationSet resources below (one per
# tier) each carry a hardcoded, literal `spec.project` — deliberately not a
# single ApplicationSet with a derived/templated project value.
#
# History, so nobody re-attempts either of these two rejected approaches:
#   1. A single ApplicationSet with per-generator `template.spec.project`
#      overrides (one git generator per tier). `spec.generators[].template`
#      does NOT exist on the installed ApplicationSet CRD outside
#      `matrix`/`merge` generators — kubectl apply was rejected outright with
#      "unknown field spec.generators[0].template" (strict decoding, no
#      partial apply, cluster was unaffected by the failed attempt).
#   2. A single ApplicationSet deriving `spec.project` from the directory
#      path via a Go-template expression using sprig's splitList/index
#      functions on `.path.path`. Never actually verified against the live
#      ApplicationSet controller —
#      not worth re-testing when two independent, structurally-proven
#      ApplicationSets (this file) need zero uncertain templating features.
---
{% for tier in ["platform", "workloads"] %}
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: home-server-apps-{{ tier }}
  namespace: {{ argocd_namespace }}
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - git:
        repoURL: "{{ argocd_repo_url }}"
        revision: "{{ argocd_repo_revision }}"
        directories:
          - path: "argocd/apps/{{ tier }}/*"
  template:
    metadata:
      name: "{{ '{{' }}.path.basename{{ '}}' }}"
    spec:
      project: {{ tier }}
      source:
        repoURL: "{{ argocd_repo_url }}"
        targetRevision: "{{ argocd_repo_revision }}"
        path: "{{ '{{' }}.path.path{{ '}}' }}"
      destination:
        server: https://kubernetes.default.svc
        namespace: "{{ '{{' }}.path.basename{{ '}}' }}"
      ignoreDifferences:
        - group: bitnami.com
          kind: SealedSecret
          jsonPointers:
            - /status
        # HPA-managed Deployments across all apps: the chart sets
        # replicas: null so Kubernetes only defaults it once at creation,
        # but ServerSideApply treats an explicit null as "clear this field",
        # which resets it to the schema default (1) on every sync — fighting
        # the HPA's scale-up and leaving the app permanently OutOfSync (seen
        # on zammad-railsserver, docs/3-apps-workloads/30000-zammad.md). Ignoring /spec/replicas
        # here only matches Applications that actually contain a resource
        # with this exact kind+name, so it's a no-op for every other app.
        - group: apps
          kind: Deployment
          name: zammad-railsserver
          jsonPointers:
            - /spec/replicas
        - group: apps
          kind: Deployment
          name: zammad-nginx
          jsonPointers:
            - /spec/replicas
        # ollama Deployment: laeuft mit replicas: 0 im Ruhezustand und wird
        # ausschliesslich vom taeglichen n8n-Workflow "Zammad Externer
        # KI-Lauf" per Kubernetes-API auf 1 hoch- und danach wieder auf 0
        # heruntergeskaliert (siehe docs/3-apps-workloads/300xx-ollama.md).
        # Ohne dieses Ignore wuerde selfHeal den Pod waehrend eines
        # laufenden KI-Laufs sofort wieder auf den Git-Wert 0 zuruecksetzen.
        - group: apps
          kind: Deployment
          name: ollama
          jsonPointers:
            - /spec/replicas
        # zammad-redis StatefulSet: Chart-Default setzt
        # updateStrategy.rollingUpdate.maxUnavailable: 1 (Redis-Subchart-
        # values.yaml), Cluster-Feature-Gate MaxUnavailableStatefulSet fehlt
        # -> Server verwirft das Feld dauerhaft. Der ursprüngliche Versuch,
        # es per "maxUnavailable: null" in values.yaml zu entfernen, wirkt
        # lokal mit Helm v3, aber NICHT mit dem Helm v4 in argocd-repo-server
        # (bestaetigt per "argocd app diff --core --hard-refresh": Desired
        # enthaelt das Feld trotzdem) -> Dauerdiff. Deshalb hier ignorieren.
        - group: apps
          kind: StatefulSet
          name: zammad-redis
          jsonPointers:
            - /spec/updateStrategy/rollingUpdate/maxUnavailable
        # victoria-metrics-operator Webhook-TLS: der Chart generiert das
        # selbstsignierte CA/Zertifikat per Helm genCA/genSignedCert bei
        # jedem Render neu. Der eingebaute Schutz dagegen
        # (admissionWebhooks.keepTLSSecret: true, Chart-Default) nutzt
        # Helm's `lookup`, um das bestehende Secret wiederzuverwenden —
        # `lookup` liefert aber bei `helm template` (das macht ArgoCDs
        # repo-server fuers Diffing) immer ein leeres Ergebnis, da dabei
        # kein Live-Cluster-Zugriff stattfindet. Der Schutz greift bei
        # ArgoCD also nie, und Secret-Daten sowie Webhook-caBundle
        # unterscheiden sich dauerhaft vom Live-Stand -> permanent
        # OutOfSync. Unbedenklich zu ignorieren, da admissionWebhooks.policy
        # bereits auf Ignore steht (siehe monitoring/values.yaml) — exakt
        # wegen derselben Webhook-Flakiness.
        - kind: Secret
          name: monitoring-victoria-metrics-operator-validation
          jsonPointers:
            - /data
        - group: admissionregistration.k8s.io
          kind: ValidatingWebhookConfiguration
          name: monitoring-victoria-metrics-operator-admission
          jqPathExpressions:
            - '.webhooks[].clientConfig.caBundle'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        # CRD/CR bootstrap (e.g. victoria-metrics-operator installs the
        # VMSingle CRD and a VMSingle resource in one sync) needs the
        # dry-run skip + retry to converge on the first reconciliation.
        retry:
          limit: 5
          backoff:
            duration: 10s
            factor: 2
            maxDuration: 5m
        syncOptions:
          - CreateNamespace=true
          - ServerSideApply=true
          - SkipDryRunOnMissingResource=true
{% if not loop.last %}
---
{% endif %}
{% endfor %}
