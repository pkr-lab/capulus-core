# Single source of truth for the two bootstrap AppProjects (platform /
# workloads namespace-tier split, see docs/b-kubernetes-gitops/b0020-argocd-projects.md).
# GENERATED alongside the ApplicationSet — run `make render-bootstrap` after
# editing this file, argocd_platform_apps/argocd_workloads_apps in
# ansible/roles/argocd/defaults/main.yml, or the argocd_repo_*/argocd_namespace
# vars in group_vars. Applied by the argocd role BEFORE the ApplicationSet,
# because Applications referencing a project that doesn't exist yet fail sync.
#
# Deliberately NOT restricting clusterResourceWhitelist/namespaceResourceWhitelist
# here (both stay as permissive as ArgoCD's built-in "default" project) —
# several platform apps install CRDs (victoria-metrics-operator, sealed-secrets)
# and locking resource kinds down without first observing real usage risks
# breaking existing, working syncs. The security value in this first pass is
# `sourceRepos` (only this repo) and `destinations` (only the tier's own
# namespaces) — resource-kind whitelisting is a deliberate later refinement,
# not an oversight.
---
{% if argocd_entw_layout | bool %}
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: entw
  namespace: {{ argocd_namespace }}
spec:
  description: >-
    ENTW (eigene ArgoCD-Instanz): alle Apps unter argocd/apps/entw/, beliebige Namespaces.
  sourceRepos:
    - "{{ argocd_repo_url }}"
  destinations:
    - server: https://kubernetes.default.svc
      namespace: "*"
  clusterResourceWhitelist:
    - group: "*"
      kind: "*"
  namespaceResourceWhitelist:
    - group: "*"
      kind: "*"
{% else %}
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: tech
  namespace: {{ argocd_namespace }}
spec:
  description: >-
    TECH-Cluster (homeserver): Plattform- und Betriebs-Apps (frueher platform + workloads). NetworkPolicy-Stufen haengen an den Listen argocd_platform_apps / argocd_workloads_apps.
  sourceRepos:
    - "{{ argocd_repo_url }}"
  destinations:
{% for app in (argocd_platform_apps + argocd_workloads_apps) | unique %}
    - server: https://kubernetes.default.svc
      namespace: {{ app }}
{% endfor %}
    # traefik-config und coredns-custom deployen nach kube-system, cert-manager hat einen eigenen
    # Namespace, ist aber bewusst NICHT in argocd_platform_apps (Cluster-Infrastruktur).
    - server: https://kubernetes.default.svc
      namespace: kube-system
    - server: https://kubernetes.default.svc
      namespace: cert-manager
  clusterResourceWhitelist:
    - group: "*"
      kind: "*"
  namespaceResourceWhitelist:
    - group: "*"
      kind: "*"
{% endif %}
