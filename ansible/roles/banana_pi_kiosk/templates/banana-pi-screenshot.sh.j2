#!/usr/bin/env bash
# Managed by Ansible (banana_pi_kiosk role) — do not edit manually.
#
# On-Demand-Screenshot der laufenden Kiosk-Session. Bewusst KEIN Timer/
# Dienst (kein x11vnc, kein periodischer Cron) -- nur manuell per SSH
# ausfuehren, wenn eine visuelle Pruefung noetig ist, siehe
# docs/3-apps-workloads/30020-vereinsheim-alarmmonitor.md, "Sichtpruefung ohne physischen
# Zugriff". Laeuft als {{ banana_pi_kiosk_user }} (gleicher User wie die
# X-Session auf :0), daher kein XAUTHORITY-Handling noetig.
set -euo pipefail

OUT="${1:-/home/{{ banana_pi_kiosk_user }}/kiosk-screenshot.png}"
DISPLAY=:0 scrot --overwrite "${OUT}"
echo "Screenshot gespeichert: ${OUT}"
echo "Abholen z. B. mit: scp {{ banana_pi_kiosk_user }}@vereinsheim-alarmmonitor:${OUT} ."
