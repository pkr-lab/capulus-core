# Kubernetes-Audit-Policy — generiert von Ansible, nicht manuell editieren.
# Security-Härtung Phase 4 (docs/d-sicherheit/d0010-security-hardening-roadmap.md,
# docs/d-sicherheit/d0050-secrets-encryption-audit-log.md).
#
# Bewusst schlank statt "RequestResponse für alles" — ein Homelab-Cluster
# mit begrenztem lokalen SSD-Platz braucht kein vollständiges
# Request+Response-Log jedes GET/LIST/WATCH (das ist mit Abstand der
# größte Traffic-Anteil und praktisch nie sicherheitsrelevant). Ziel:
# nachvollziehen können WER WAS WANN GEÄNDERT hat (Metadata-Level reicht
# dafür — Zeitstempel, Nutzer, Verb, Objekt, aber ohne Full-Body-Dump),
# nicht ein vollständiges API-Traffic-Mitschnitt.
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - "RequestReceived"
rules:
  # Lesender Traffic erzeugt den mit Abstand größten Log-Anteil und ist
  # praktisch nie sicherheitsrelevant (Grafana/vmagent/ArgoCD pollen
  # ständig) — komplett ausgeschlossen.
  - level: None
    verbs: ["get", "list", "watch"]

  # System-eigener Traffic (kube-system-ServiceAccounts, Health-/Readiness-
  # Checks, Discovery) — Rauschen, kein Sicherheitswert.
  - level: None
    userGroups: ["system:nodes", "system:serviceaccounts:kube-system"]
  - level: None
    nonResourceURLs:
      - "/api*"
      - "/version"
      - "/healthz*"
      - "/readyz*"
      - "/livez*"
      - "/metrics"

  # Secrets/ConfigMaps: wer legt an/ändert/löscht — Kernstück dieser
  # Phase, direkt neben der Secrets-Encryption. Metadata-Level (nicht
  # RequestResponse), damit Secret-Inhalte selbst NICHT im Audit-Log
  # landen — sonst würde das Log genau das aushebeln, was die
  # Encryption-at-Rest gerade schützen soll.
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps"]

  # RBAC-Änderungen — wer bekommt/verliert welche Rechte.
  - level: Metadata
    resources:
      - group: "rbac.authorization.k8s.io"
        resources: ["clusterroles", "clusterrolebindings", "roles", "rolebindings"]

  # Pod-Exec/-Attach — interaktiver Zugriff in laufende Container.
  - level: Metadata
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach", "pods/portforward"]

  # Alles andere (Deployments, Services, NetworkPolicies, Namespaces, …)
  # auf Metadata-Level als Auffangregel — deckt z. B. auch künftige
  # NetworkPolicy-Änderungen (docs/d-sicherheit/d0030-network-policies.md) ab, ohne für jeden Resource-Typ
  # eine eigene Regel zu brauchen.
  - level: Metadata
