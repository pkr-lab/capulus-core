[Unit]
Description=Nightly worker wake/update/shutdown cycle (WoL -> Semaphore apt update -> poweroff)
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nightly-worker-wake/config.env
ExecStart=/usr/local/bin/nightly-worker-wake.sh
TimeoutStartSec=1500
