# Managed by Ansible (vmagent role) — do not edit manually.
scrape_configs:
  - job_name: node-exporter
    scrape_interval: {{ vmagent_scrape_interval }}
    static_configs:
      - targets: ["127.0.0.1:{{ vmagent_node_exporter_port }}"]
        labels:
          instance: {{ inventory_hostname }}
          # Einheitliche Filter-Labels der Hardware-Dashboards
          # (docs/2-betrieb-hardware/20060-hardware-monitoring.md).
          host: {{ inventory_hostname }}
          kind: pi
