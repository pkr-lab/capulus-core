[Unit]
Description=vmagent (Metriken-Push fuer {{ inventory_hostname }})
After=network-online.target prometheus-node-exporter.service
Wants=network-online.target

[Service]
User=vmagent
Group=vmagent
ExecStart={{ vmagent_install_dir }}/vmagent-prod \
  -promscrape.config=/etc/vmagent/scrape.yml \
  -remoteWrite.url={{ vmagent_remote_write_url }} \
  -remoteWrite.tmpDataPath=/var/lib/vmagent \
  -remoteWrite.queues={{ vmagent_remote_write_queues }} \
  -loggerLevel=WARN
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
