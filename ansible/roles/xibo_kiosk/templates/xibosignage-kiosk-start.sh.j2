#!/usr/bin/env bash
set -euo pipefail

export DISPLAY=:0

xset s off || true
xset s noblank || true
xset -dpms || true

until curl --fail --silent --max-time 2 "http://127.0.0.1:{{ xibo_kiosk_http_port }}/" >/dev/null 2>&1; do
  sleep 1
done

if command -v chromium-browser >/dev/null 2>&1; then
  CHROMIUM_BIN=chromium-browser
elif command -v chromium >/dev/null 2>&1; then
  CHROMIUM_BIN=chromium
else
  echo "Weder chromium-browser noch chromium gefunden." >&2
  exit 1
fi

exec "$CHROMIUM_BIN" \
  --kiosk \
  --incognito \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --autoplay-policy=no-user-gesture-required \
  --check-for-update-interval=31536000 \
  "http://127.0.0.1:{{ xibo_kiosk_http_port }}/"
