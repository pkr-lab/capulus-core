    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Konfiguration ─────────────────────────────────────────────\nconst ADRESSEN = [\n  'paperless@edv-kretzer.de',\n  'p.kretzer29@gmail.com',\n  'peter.kretzer29@gmail.com',\n  'peterkretzer36@gmail.com',\n  'peterkretzer37@gmail.com',\n  'ichwillkeinewerbung9901@gmail.com',\n  'info@edv-kretzer.de',\n];\n\n// Bilder unter dieser Größe gelten als Deko (Logo/Pixel), nicht als Dokument\nconst MIN_IMAGE_SIZE = 40000; // 40 KB – bei Bedarf anpassen\n\n// Diese Typen sind immer echte Dokumente\nconst DOC_TYPES = [\n  'application/pdf',\n  'application/msword',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  'application/vnd.ms-excel',\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n];\nconst DOC_EXTS = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'csv', 'txt', 'odt', 'ods'];\n\n// ── MIME-Baum in einzelne Teile zerlegen ─────────────────────\nfunction leaves(node, acc) {\n  if (!node) return acc;\n  if (Array.isArray(node.childNodes)) {\n    node.childNodes.forEach(c => leaves(c, acc));\n  } else {\n    acc.push(node);\n  }\n  return acc;\n}\n\n// ── Einen Teil klassifizieren ─────────────────────────────────\nfunction classify(node) {\n  const type = (node.type || '').toLowerCase();\n  const fname =\n    (node.dispositionParameters && node.dispositionParameters.filename) ||\n    (node.parameters && node.parameters.name) || '';\n  const ext = fname.includes('.') ? fname.split('.').pop().toLowerCase() : '';\n  const size = node.size || 0;\n  const hasCid = !!node.id; // Content-ID → im Text eingebettet\n\n  // PDFs / Office-Dokumente → immer Dokument\n  if (DOC_TYPES.includes(type) || DOC_EXTS.includes(ext)) return 'document';\n\n  // Bilder: echtes Dokument nur, wenn NICHT eingebettet UND groß genug\n  if (type.startsWith('image/')) {\n    if (hasCid) return 'inline-image';       // Logo/Signatur/Kontaktfoto\n    if (size < MIN_IMAGE_SIZE) return 'small-image';\n    return 'document';                        // eigenständiges Foto/Scan\n  }\n\n  return 'other';\n}\n\n// ── Auswertung ────────────────────────────────────────────────\nconst json = $input.item.json;\nconst parts = leaves(json.bodyStructure, []);\n\nconst files = parts\n  .filter(p => {\n    const t = (p.type || '').toLowerCase();\n    return t && !t.startsWith('text/'); // Text ist nie eine Datei\n  })\n  .map(p => ({\n    type: p.type,\n    size: p.size || 0,\n    hasCid: !!p.id,\n    filename:\n      (p.dispositionParameters && p.dispositionParameters.filename) ||\n      (p.parameters && p.parameters.name) || null,\n    class: classify(p),\n  }));\n\njson.hasAttachment = files.length > 0;\njson.hasDocument = files.some(f => f.class === 'document');\njson.files = files; // Debug: zeigt Typ, Größe, CID, Klasse\n\njson.isMeineAdresse = (json.envelope && json.envelope.to ? json.envelope.to : [])\n  .some(r => ADRESSEN.includes((r.address || '').toLowerCase()));\n\nreturn $input.item;"
      },
