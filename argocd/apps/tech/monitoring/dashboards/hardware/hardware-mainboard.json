        "1": {
         "color": "green",
         "index": 1,
         "text": "Online"
        },
        "2": {
         "color": "blue",
         "index": 2,
         "text": "Schläft"
        },
        "3": {
         "color": "green",
         "index": 3,
         "text": "Online (gesperrt)"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
