    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    },
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Server",
      "desc": false
     }
    ]
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"}) + on(host) group_left() (max by (host) (label_replace(kube_node_spec_unschedulable == 1, \"host\", \"$1\", \"node\", \"(.*)\")) * 0 + 2)) or max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (host,kind) (count by (host,kind,cpu) (node_cpu_seconds_total{mode=\"idle\",host!=\"\"}))",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 - avg by (host,kind) (rate(node_cpu_seconds_total{mode=\"idle\",host!=\"\"}[5m])) * 100",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (host,kind) (node_load1{host!=\"\"}) / count by (host,kind) (node_cpu_seconds_total{mode=\"idle\",host!=\"\"})",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (host,kind) (node_memory_MemTotal_bytes{host!=\"\"})",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * (1 - sum by (host,kind) (node_memory_MemAvailable_bytes{host!=\"\"}) / sum by (host,kind) (node_memory_MemTotal_bytes{host!=\"\"}))",
     "legendFormat": "",
     "refId": "F",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
