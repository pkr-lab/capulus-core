      "value": 998
     },
     {
      "color": "#F2495C",
      "state": 2,
      "value": 999
     }
    ],
    "sortByField": "name",
    "sortByDirection": 1,
    "layoutDisplayLimit": 100
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host) (label_replace(100 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host!=\"\"}[5m])) * 100, \"m\", \"cpu\", \"host\", \".*\") or label_replace(100 * (1 - sum by (host) (node_memory_MemAvailable_bytes{host!=\"\"}) / sum by (host) (node_memory_MemTotal_bytes{host!=\"\"})), \"m\", \"ram\", \"host\", \".*\") or label_replace(max by (host) ((1 - node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} / node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}) * 100), \"m\", \"fs\", \"host\", \".*\"))",
     "legendFormat": "{{host}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host) (((max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"}) + on(host) group_left() (max by (host) (label_replace(kube_node_spec_unschedulable == 1, \"host\", \"$1\", \"node\", \"(.*)\")) * 0 + 2)) or max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"})) == 2) * 0 + 998",
     "legendFormat": "{{host}}",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host) (((max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"}) + on(host) group_left() (max by (host) (label_replace(kube_node_spec_unschedulable == 1, \"host\", \"$1\", \"node\", \"(.*)\")) * 0 + 2)) or max by (host,kind) (up{job=~\".*node-exporter.*\", host!=\"\"})) == 0) * 0 + 999",
     "legendFormat": "{{host}}",
     "refId": "C"
    }
   ],
   "title": "Server (schlechtester Wert aus CPU, RAM, Dateisystem)",
