{
 "annotations": {
  "list": []
 },
 "description": "Füllstand aller Dateisysteme (inkl. NAS-Volumes), Prognose 'Tage bis voll', RAID-Zustand und S.M.A.R.T.-Gesundheit aller SSDs/HDDs/NVMe.",
 "editable": true,
 "graphTooltip": 1,
 "links": [
  {
   "asDropdown": false,
   "icon": "dashboard",
   "includeVars": false,
   "keepTime": true,
   "tags": [
    "hardware"
   ],
   "targetBlank": false,
   "title": "Hardware-Dashboards",
   "tooltip": "",
   "type": "dashboards",
   "url": ""
  }
 ],
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Status",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": []
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "autoSizeColumns": true,
    "autoSizeRows": true,
    "autoSizePolygons": true,
    "globalShape": "hexagon_pointed_top",
    "globalOperator": "lastNotNull",
    "globalUnitFormat": "percent",
    "globalDecimals": 0,
    "globalDisplayMode": "all",
    "globalShowValueEnabled": true,
    "globalTooltipsEnabled": true,
    "globalTooltipsShowValueEnabled": true,
    "globalTooltipsShowTimestampEnabled": false,
    "globalPolygonBorderSize": 2,
    "globalPolygonBorderColor": "rgba(0, 0, 0, 0)",
    "globalTextFontAutoColorEnabled": true,
    "globalAutoScaleFonts": true,
    "globalTextFontFamily": "Inter",
    "globalTooltipsFontFamily": "Inter",
    "ellipseEnabled": true,
    "ellipseCharacters": 14,
    "globalThresholdsConfig": [
     {
      "color": "#73BF69",
      "state": 0,
      "value": 0
     },
     {
      "color": "#FADE2A",
      "state": 1,
      "value": 75
     },
     {
      "color": "#F2495C",
      "state": 2,
      "value": 90
     }
    ],
    "sortByField": "value",
    "sortByDirection": 4,
    "layoutDisplayLimit": 100
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "label_replace(label_replace(max by (host,mountpoint) ((1 - node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} / node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}) * 100), \"mp\", \"$1\", \"mountpoint\", \"(.*)\"), \"mp\", \"$1\", \"mountpoint\", \".*/([^/]+)\")",
     "legendFormat": "{{host}}:{{mp}}",
     "refId": "A"
    }
   ],
   "title": "Füllstand der Dateisysteme",
   "type": "grafana-polystat-panel",
   "description": "Ein Sechseck je Dateisystem. grün < 75 %, gelb ≥ 75 %, rot ≥ 90 %."
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "998": {
         "text": "schläft"
        },
        "999": {
         "text": "offline"
        },
        "1000": {
         "text": "FAILED"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "id": 3,
   "options": {
    "autoSizeColumns": true,
    "autoSizeRows": true,
    "autoSizePolygons": true,
    "globalShape": "hexagon_pointed_top",
    "globalOperator": "lastNotNull",
    "globalUnitFormat": "celsius",
    "globalDecimals": 0,
    "globalDisplayMode": "all",
    "globalShowValueEnabled": true,
    "globalTooltipsEnabled": true,
    "globalTooltipsShowValueEnabled": true,
    "globalTooltipsShowTimestampEnabled": false,
    "globalPolygonBorderSize": 2,
    "globalPolygonBorderColor": "rgba(0, 0, 0, 0)",
    "globalTextFontAutoColorEnabled": true,
    "globalAutoScaleFonts": true,
    "globalTextFontFamily": "Inter",
    "globalTooltipsFontFamily": "Inter",
    "ellipseEnabled": true,
    "ellipseCharacters": 14,
    "globalThresholdsConfig": [
     {
      "color": "#73BF69",
      "state": 0,
      "value": 0
     },
     {
      "color": "#FADE2A",
      "state": 1,
      "value": 45
     },
     {
      "color": "#F2495C",
      "state": 2,
      "value": 55
     },
     {
      "color": "#F2495C",
      "state": 2,
      "value": 1000
     }
    ],
    "sortByField": "name",
    "sortByDirection": 1,
    "layoutDisplayLimit": 100
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,device) (smartctl_device_temperature{host!=\"\"}) + on(host,device) (1000 * (1 - max by (host,device) (smartctl_device_smart_status{host!=\"\"})))",
     "legendFormat": "{{host}}/{{device}}",
     "refId": "A"
    }
   ],
   "title": "Laufwerke (Temperatur; S.M.A.R.T.-Fehler rot)",
   "type": "grafana-polystat-panel",
   "description": "Ein Sechseck je physischer Platte, Wert = Temperatur."
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 11
   },
   "id": 4,
   "panels": [],
   "title": "Dateisysteme aller Server",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Server"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Server-Detail öffnen",
          "url": "/d/hardware-host?var-host=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Größe|Belegt|Frei"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Belegt %|Inodes %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "yellow",
           "value": 75
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Tage bis voll"
      },
      "properties": [
       {
        "id": "unit",
        "value": "d"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "range",
          "options": {
           "from": 9500,
           "to": 1000000000.0,
           "result": {
            "index": 0,
            "text": "wächst nicht",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "yellow",
           "value": 14
          },
          {
           "color": "green",
           "value": 60
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "id": 5,
   "options": {
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    },
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Belegt %",
      "desc": true
     }
    ]
   },
