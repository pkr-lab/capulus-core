    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,mountpoint,device,fstype) (node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,mountpoint,device,fstype) (node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} - node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"})",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,mountpoint,device,fstype) (node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"})",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,mountpoint,device,fstype) ((1 - node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} / node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}) * 100)",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "clamp_max(max by (host,mountpoint,device,fstype) (node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} / ((-deriv(node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}[7d])) > 0)) / 86400, 9000) or (max by (host,mountpoint,device,fstype) (node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}) * 0 + 99999)",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (host,mountpoint,device,fstype) ((1 - node_filesystem_files_free{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"} / node_filesystem_files{fstype=~\"ext[234]|xfs|btrfs|zfs|f2fs\", mountpoint!~\"/boot|/boot/efi|/rootfs|/ugreen|/mnt/factory|/var/log.*\", host!=\"\"}) * 100)",
     "legendFormat": "",
     "refId": "F",
     "instant": true,
     "format": "table"
    }
   ],
   "title": "Alle Dateisysteme",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "host": 0,
       "mountpoint": 1,
       "device": 2,
       "fstype": 3,
       "Value #A": 4,
       "Value #B": 5,
       "Value #C": 6,
       "Value #D": 7,
       "Value #E": 8,
       "Value #F": 9
      },
      "renameByName": {
       "host": "Server",
       "mountpoint": "Mount",
       "device": "Gerät",
       "fstype": "Typ",
       "Value #A": "Größe",
       "Value #B": "Belegt",
       "Value #C": "Frei",
       "Value #D": "Belegt %",
       "Value #E": "Tage bis voll",
       "Value #F": "Inodes %"
      }
     }
    }
   ],
   "type": "table",
   "description": "'Tage bis voll' = lineare Prognose aus dem Trend der letzten 7 Tage (nur bei schrumpfendem freiem Platz). Dateisysteme ohne Wachstum zeigen 'wächst nicht'."
  },
