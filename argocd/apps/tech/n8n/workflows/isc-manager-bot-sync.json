    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nreturn [{\n  json: {\n    ...item.json,\n    ntfyTopic: 'isc-manager',\n    ntfyUrl: 'http://ntfy.ntfy.svc.cluster.local',\n    iscManagerBotUrl: 'http://isc-manager-bot.isc-manager-bot.svc.cluster.local:8080'\n  }\n}];\n"
      },
      "id": "1d646172-78f5-5e41-8ffb-f76ae2068f01",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst src = item.json;\nconst cfg = {\n  ntfyTopic: src.ntfyTopic,\n  ntfyUrl: src.ntfyUrl,\n  iscManagerBotUrl: src.iscManagerBotUrl\n};\nconst toText = (v) => (typeof v === 'string' ? v.trim() : '');\nconst istFormular = src['Vorname'] !== undefined || src['Nachname'] !== undefined;\nlet quelle = 'Mail';\nlet vorname = '';\nlet nachname = '';\nlet nummer = '';\nlet dryRun = false;\nconst fehler = [];\nif (istFormular) {\n  quelle = 'Formular';\n  vorname = toText(src['Vorname']);\n  nachname = toText(src['Nachname']);\n  nummer = toText(src['DLRG-Manager-ID']);\n  dryRun = toText(src['Testlauf (nichts speichern)']) !== 'Nein';\n} else {\n  const text = toText(src.textPlain || src.text || '');\n  let daten = null;\n  try {\n    daten = JSON.parse(text);\n  } catch (e) {\n    daten = null;\n  }\n  if (daten && typeof daten === 'object' && !Array.isArray(daten)) {\n    vorname = toText(daten.vorname);\n    nachname = toText(daten.nachname);\n    nummer = toText(String(daten.mitgliedsnummer === undefined || daten.mitgliedsnummer === null ? '' : daten.mitgliedsnummer));\n    dryRun = daten.dryRun === true;\n  } else {\n    fehler.push('Mailtext ist kein lesbares JSON mit vorname und nachname');\n  }\n}\nif (vorname === '') fehler.push('Vorname fehlt');\nif (nachname === '') fehler.push('Nachname fehlt');\nif (nummer !== '' && !/^\\d{13}$/.test(nummer)) fehler.push('DLRG-Manager-ID muss 13 Ziffern haben');\nconst payload = { vorname, nachname, dryRun };\nif (nummer !== '') payload.mitgliedsnummer = nummer;\nreturn [{ json: { ...cfg, quelle, valid: fehler.length === 0, fehler, payload } }];\n"
      },
