      "id": "7a60ce14-9877-436b-81c1-30cdc58feba6",
      "name": "E-Mail empfangen",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        240,
        560
      ],
      "credentials": {
        "imap": {
          "id": "ISC_NEWS_IMAP_CREDENTIAL_ID",
          "name": "ISC-News Postfach (IMAP)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst subject = String(item.json.subject || '').trim();\nif (subject !== 'HOMEPAGE1002011') return [];\nconst keys = Object.keys(item.binary || {});\nconst from = typeof item.json.from === 'string' ? item.json.from : ((item.json.from && item.json.from.text) || '');\nconst base = { subject, from };\nconst jsonKey = keys.find((k) => item.binary[k].mimeType === 'application/json' || /\\.json$/i.test(item.binary[k].fileName || ''));\nif (!jsonKey) return [{ json: { ...base, body: {}, mailError: 'Kein JSON-Anhang in der Mail' } }];\nlet data;\ntry {\n  data = JSON.parse((await this.helpers.getBinaryDataBuffer(0, jsonKey)).toString('utf8'));\n} catch (e) {\n  data = null;\n}\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n  return [{ json: { ...base, body: {}, mailError: 'JSON-Anhang ist nicht lesbar' } }];\n}\nconst pick = (...names) => {\n  for (const name of names) {\n    const v = data[name];\n    if (v !== undefined && v !== null && v !== '') return v;\n  }\n  return undefined;\n};\nconst mimeOf = (fileName, mimeType) => {\n  const byExt = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };\n  const ext = String(fileName || '').split('.').pop().toLowerCase();\n  const wanted = mimeType === 'image/jpg' ? 'image/jpeg' : mimeType;\n  return ['image/jpeg', 'image/png', 'image/webp'].includes(wanted) ? wanted : byExt[ext];\n};\nconst images = [];\nfor (const key of keys) {\n  if (key === jsonKey) continue;\n  const meta = item.binary[key];\n  const mime = mimeOf(meta.fileName, meta.mimeType);\n  if (!mime) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  images.push({ fileName: meta.fileName, mimeType: mime, dataBase64: buffer.toString('base64') });\n}\nconst modeRaw = String(pick('mode', 'Modus') || '');\nreturn [{\n  json: {\n    ...base,\n    body: {\n      title: pick('title', 'Überschrift'),\n      subtitle: pick('subtitle', 'Untertitel'),\n      text: pick('text', 'Text'),\n      html: pick('html'),\n      categories: pick('categories', 'Kategorie(n)'),\n      startDate: pick('startDate', 'Veröffentlichung ab'),\n      mode: /publish|veröffentl/i.test(modeRaw) ? 'publish' : 'draft',\n      images\n    }\n  }\n}];\n"
      },
      "id": "6930c090-008f-438f-8465-ddf8776b5e2d",
