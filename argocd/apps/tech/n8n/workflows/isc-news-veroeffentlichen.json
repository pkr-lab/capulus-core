    },
    {
      "parameters": {
        "postProcessAction": "read",
        "format": "simple",
        "downloadAttachments": true,
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "customEmailConfig": "[\"UNSEEN\", [\"SUBJECT\", \"HOMEPAGE1002011\"]]",
          "forceReconnect": 60,
          "trackLastMessageId": true
