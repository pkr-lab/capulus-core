    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nreturn [{\n  json: {\n    ...item.json,\n    testModus: false,\n    ntfyFreigabe: false,\n    ntfyTopic: 'isc-news',\n    ntfyUrl: 'http://ntfy.ntfy.svc.cluster.local',\n    iscNewsBotUrl: 'http://isc-news-bot.isc-news-bot.svc.cluster.local:8080'\n  },\n  binary: item.binary\n}];\n"
      },
      "id": "cd27e7e3-0d73-45f7-9856-f811cf937067",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst src = item.json;\nconst cfg = {\n  testModus: src.testModus === true,\n  ntfyFreigabe: src.ntfyFreigabe === true,\n  ntfyTopic: src.ntfyTopic,\n  ntfyUrl: src.ntfyUrl,\n  iscNewsBotUrl: src.iscNewsBotUrl\n};\nconst isWebhook = src.body !== undefined && typeof src.body === 'object';\nconst body = isWebhook ? src.body : {};\nconst pick = (label, key) => (isWebhook ? body[key] : src[label]);\nconst toText = (v) => (typeof v === 'string' ? v.trim() : '');\nconst toList = (v) => {\n  if (Array.isArray(v)) return v.map((x) => String(x).trim()).filter((x) => x.length > 0);\n  if (typeof v === 'string') return v.split(',').map((x) => x.trim()).filter((x) => x.length > 0);\n  return [];\n};\nconst esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst link = (s) => s.replace(/(https?:\\/\\/[^\\s<]+[^\\s<.,;:!?)])/g, '<a href=\"$1\">$1</a>');\nconst title = toText(pick('Überschrift', 'title'));\nconst subtitle = toText(pick('Untertitel', 'subtitle'));\nconst text = toText(pick('Text', 'text'));\nconst categories = toList(pick('Kategorie(n)', 'categories'));\nconst startDate = toText(pick('Veröffentlichung ab (leer = sofort, JJJJ-MM-TTTHH:mm)', 'startDate'));\nconst modeRaw = toText(pick('Modus', 'mode'));\nconst mode = isWebhook\n  ? (modeRaw === 'publish' ? 'publish' : 'draft')\n  : (modeRaw === 'Veröffentlichen' ? 'publish' : 'draft');\nconst rawHtml = isWebhook ? toText(body.html) : '';\nconst html = rawHtml || (text\n  ? text.split(/\\n\\s*\\n/).map((p) => '<p>' + link(esc(p.trim()).replace(/\\n/g, '<br>')) + '</p>').join('')\n  : '');\n\nconst images = [];\nif (isWebhook) {\n  for (const img of Array.isArray(body.images) ? body.images : []) {\n    images.push({ fileName: img.fileName, mimeType: img.mimeType, dataBase64: img.dataBase64, keywords: img.keywords });\n  }\n} else {\n  for (const key of Object.keys(item.binary || {})) {\n    const meta = item.binary[key];\n    const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n    images.push({ fileName: meta.fileName, mimeType: meta.mimeType, dataBase64: buffer.toString('base64') });\n  }\n}\n\nconst errors = [];\nif (src.mailError) errors.push(src.mailError);\nif (!title) errors.push('Überschrift fehlt');\nif (!html) errors.push('Text fehlt');\n\nconst payload = { title, subtitle, html, type: 'text', categories, mode, dryRun: cfg.testModus, images };\nif (startDate) payload.startDate = startDate;\n\nreturn [{\n  json: {\n    ...cfg,\n    valid: errors.length === 0,\n    error: errors.join(', '),\n    title,\n    mode,\n    imageCount: images.length,\n    payload\n  }\n}];\n"
      },
