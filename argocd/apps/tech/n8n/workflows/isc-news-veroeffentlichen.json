    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst subject = String(item.json.subject || '').trim();\nif (subject !== 'HOMEPAGE1002011') return [];\nconst keys = Object.keys(item.binary || {});\nconst from = typeof item.json.from === 'string' ? item.json.from : ((item.json.from && item.json.from.text) || '');\nconst base = { subject, from };\nif (!from.toLowerCase().includes('peter.kretzer@dlrg.org')) return [];\nconst jsonKey = keys.find((k) => item.binary[k].mimeType === 'application/json' || /\\.json$/i.test(item.binary[k].fileName || ''));\nif (!jsonKey) return [{ json: { ...base, body: {}, mailError: 'Kein JSON-Anhang in der Mail' } }];\nconst tryParse = (s) => {\n  try { return JSON.parse(s); } catch (e) { return null; }\n};\nconst jsonText = (await this.helpers.getBinaryDataBuffer(0, jsonKey)).toString('utf8').replace(/^\\uFEFF/, '').trim();\nlet data = tryParse(jsonText);\nif (data === null && /^[A-Za-z0-9+/=\\s]+$/.test(jsonText)) data = tryParse(Buffer.from(jsonText, 'base64').toString('utf8'));\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n  return [{ json: { ...base, body: {}, mailError: 'JSON-Anhang ist nicht lesbar' } }];\n}\nconst pick = (...names) => {\n  for (const name of names) {\n    const v = data[name];\n    if (v !== undefined && v !== null && v !== '') return v;\n  }\n  return undefined;\n};\nconst mimeOf = (fileName, mimeType) => {\n  const byExt = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };\n  const ext = String(fileName || '').split('.').pop().toLowerCase();\n  const wanted = mimeType === 'image/jpg' ? 'image/jpeg' : mimeType;\n  return ['image/jpeg', 'image/png', 'image/webp'].includes(wanted) ? wanted : byExt[ext];\n};\nconst images = [];\nfor (const key of keys) {\n  if (key === jsonKey) continue;\n  const meta = item.binary[key];\n  const mime = mimeOf(meta.fileName, meta.mimeType);\n  if (!mime) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  images.push({ fileName: meta.fileName, mimeType: mime, dataBase64: buffer.toString('base64') });\n}\nconst cleanHtml = (h) => (typeof h === 'string'\n  ? h.replace(/<attachment\\b[^>]*>\\s*<\\/attachment>/gi, '').replace(/<p>(\\s|&nbsp;)*<\\/p>/gi, '').trim()\n  : h);\nconst modeRaw = String(pick('mode', 'Modus') || '');\nreturn [{\n  json: {\n    ...base,\n    body: {\n      title: pick('title', 'titel', 'Überschrift'),\n      subtitle: pick('subtitle', 'untertitel', 'Untertitel'),\n      text: pick('text', 'Text'),\n      html: cleanHtml(pick('html')),\n      categories: pick('categories', 'kategorien', 'Kategorie(n)'),\n      startDate: pick('startDate', 'Veröffentlichung ab'),\n      mode: /draft|entwurf/i.test(modeRaw) ? 'draft' : 'publish',\n      images\n    }\n  }\n}];\n"
      },
