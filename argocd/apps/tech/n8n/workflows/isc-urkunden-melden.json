    {
      "parameters": {},
      "id": "e5e5e5e5-0002-4000-8000-000000000002",
      "name": "Manuell testen",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = {\n  testModus: false,\n  mailAn: 'EMPFAENGER_EINTRAGEN',\n  mailVon: 'ABSENDER_EINTRAGEN',\n  ntfyUrl: 'http://ntfy.ntfy.svc.cluster.local',\n  ntfyTopic: 'isc-urkunden',\n  iscNewsBotUrl: 'http://isc-news-bot.isc-news-bot.svc.cluster.local:8080',\n  wochentag: 4,\n  startAb: '17:25',\n  endeBis: '20:00'\n};\nif (!cfg.mailAn.includes('@') || !cfg.mailVon.includes('@')) {\n  throw new Error('mailAn und mailVon im Node Konfiguration eintragen');\n}\nconst teile = Object.fromEntries(\n  new Intl.DateTimeFormat('en-GB', {\n    timeZone: 'Europe/Berlin',\n    weekday: 'short',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    hourCycle: 'h23'\n  }).formatToParts(new Date()).map((p) => [p.type, p.value])\n);\nconst tage = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };\nconst heute = `${teile.year}-${teile.month}-${teile.day}`;\nconst zeit = `${teile.hour}:${teile.minute}`;\nconst imFenster = tage[teile.weekday] === cfg.wochentag && zeit >= cfg.startAb && zeit <= cfg.endeBis;\nif (!cfg.testModus && !imFenster) return [];\nreturn [{ json: { ...cfg, heute, zeit, jahr: teile.year } }];\n"
      },
      "id": "e5e5e5e5-0003-4000-8000-000000000003",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Konfiguration').first().json.iscNewsBotUrl }}/urkunden?jahr={{ $('Konfiguration').first().json.jahr }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e5e5e5e5-0004-4000-8000-000000000004",
      "name": "Urkunden abrufen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ISC_NEWS_BOT_CREDENTIAL_ID",
          "name": "ISC-News-Bot API-Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Konfiguration').first().json;\nconst antwort = $input.first().json || {};\nif (antwort.ok !== true || !Array.isArray(antwort.urkunden)) {\n  const text = 'Fehler ' + (antwort.errorCode || '-') + ' im Schritt ' + (antwort.step || '-') + ' | ' + (antwort.error || 'keine Antwort vom ISC-News-Bot');\n  return [{ json: { art: 'fehler', text } }];\n}\nconst urkunden = antwort.urkunden;\nif (cfg.testModus) {\n  return urkunden.length > 0 ? [{ json: { art: 'mail', urkunden } }] : [];\n}\nconst speicher = $getWorkflowStaticData('global');\nconst stand = speicher.urkundenStand;\nif (!stand || stand.datum !== cfg.heute) {\n  speicher.urkundenStand = { datum: cfg.heute, ids: urkunden.map((u) => u.uid) };\n  return [];\n}\nconst bekannt = new Set(stand.ids);\nconst neue = urkunden.filter((u) => !bekannt.has(u.uid));\nif (neue.length === 0) return [];\nspeicher.urkundenStand = { datum: cfg.heute, ids: [...bekannt, ...neue.map((u) => u.uid)] };\nreturn [{ json: { art: 'mail', urkunden: neue } }];\n"
      },
      "id": "e5e5e5e5-0005-4000-8000-000000000005",
      "name": "Neue ermitteln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e5e5e5e5-0011-4000-8000-000000000011",
              "leftValue": "={{ $json.art }}",
              "rightValue": "fehler",
