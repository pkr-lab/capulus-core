      "id": "e5e5e5e5-0006-4000-8000-000000000006",
      "name": "Fehler?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Konfiguration').first().json;\nconst urkunden = $input.first().json.urkunden;\nconst de = (iso) => (/^\\d{4}-\\d{2}-\\d{2}$/.test(iso || '') ? `${iso.slice(8, 10)}.${iso.slice(5, 7)}.${iso.slice(0, 4)}` : '-');\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst name = (u) => u.name || [u.vorname, u.nachname].filter(Boolean).join(' ') || '-';\nconst zeilen = (u) => [\n  ['Name', name(u)],\n  ['Geburtsdatum', de(u.geburtsdatum)],\n  ['Abzeichen', u.abzeichen || '-'],\n  ['Prüfer', `${u.prueferName || '-'} (${u.prueferNummer || '-'})`],\n  ['Registriernummer', u.registriernummer || '-']\n];\nconst text = urkunden.map((u) => zeilen(u).map(([k, v]) => `${k}: ${v}`).join('\\n')).join('\\n\\n');\nconst html = urkunden\n  .map((u) => '<table style=\"border-collapse:collapse;margin-bottom:16px\">' + zeilen(u).map(([k, v]) => `<tr><td style=\"padding:2px 12px 2px 0\"><b>${esc(k)}</b></td><td>${esc(v)}</td></tr>`).join('') + '</table>')\n  .join('');\nconst betreff = (cfg.testModus ? '[TEST] ' : '') + (urkunden.length === 1\n  ? `Neue Urkunde: ${urkunden[0].abzeichen || '-'} – ${name(urkunden[0])}`\n  : `${urkunden.length} neue Urkunden im ISC`);\nreturn [{ json: { mailAn: cfg.mailAn, mailVon: cfg.mailVon, betreff, text, html } }];\n"
      },
