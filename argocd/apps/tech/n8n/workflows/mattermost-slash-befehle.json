      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://mattermost.mattermost.svc.cluster.local:8065/api/v4/users/' + encodeURIComponent($json.user_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "fu9GDp3BYYVp4L5i",
          "name": "Mattermost Bot (News)"
        }
      }
    },
    {
      "id": "236978c9-fa44-555c-bb36-933461ffa313",
      "name": "Berechtigung pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const befehl = $('Befehl auswerten').first().json;\nconst nutzer = $input.first().json;\nconst admin = String(nutzer.roles || '').split(' ').includes('system_admin');\nreturn [{ json: { ...befehl, erlaubt: admin && befehl.text.length > 0, ist_admin: admin } }];"
      }
    },
