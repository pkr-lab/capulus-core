    {
      "id": "74d0ad41-5f50-543e-9428-6bd216ff3754",
      "name": "Aktive Alerts abfragen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "http://vmsingle-monitoring-victoria-metrics-k8s-stack.monitoring.svc.cluster.local:8428/api/v1/query",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "count by (alertname, severity) (ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"})"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d48689a4-9aee-5c46-ac1a-d30620894913",
      "name": "Antwort Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reihen = (($input.first().json.data || {}).result || []);\nif (reihen.length === 0) {\n  return [{ json: { response_type: 'ephemeral', text: '\\u2705 Keine aktiven Alerts.' } }];\n}\nconst zeilen = reihen.map((reihe) => '| ' + (reihe.metric.alertname || '?') + ' | ' + (reihe.metric.severity || '-') + ' | ' + reihe.value[1] + ' |');\nreturn [{ json: { response_type: 'ephemeral', text: '#### \\u{1F525} Aktive Alerts\\n\\n| Alert | Schwere | Anzahl |\\n|---|---|---|\\n' + zeilen.join('\\n') } }];"
      }
    },
    {
      "id": "86d1a734-066b-585a-aeb5-1f69778c4d4d",
      "name": "Antwort Hilfe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { response_type: 'ephemeral', text: 'Verfuegbare Befehle:\\n- `/ticket <Titel>` legt ein Zammad-Ticket an (nur Admins)\\n- `/status` zeigt aktive Alerts' } }];"
      }
    }
  ],
