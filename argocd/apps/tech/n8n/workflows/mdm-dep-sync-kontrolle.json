      "id": "841c597e-9950-5eab-83fa-cf7cd58f6d68",
      "name": "Assigner pruefen Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        160
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM NanoDEP API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const unassigned = (devices) => devices\n  .filter((device) => device.op_type !== 'deleted')\n  .filter((device) => !device.profile_uuid || device.profile_status === 'empty')\n  .map((device) => device.serial_number);\nconst cfg = $('Konfiguration Sync').first().json;\nconst details = $('Geraetedetails abrufen').first().json;\nconst assigner = $input.first().json;\nconst map = (details.body && details.body.devices) || {};\nconst list = Array.isArray(map) ? map : Object.values(map);\nreturn [{ json: { source: 'Sync', unassigned: unassigned(list), detailStatus: details.statusCode, assignerMissing: !(assigner.statusCode === 200 && assigner.body && assigner.body.profile_uuid), ntfyUrl: cfg.ntfyUrl, ntfyTopic: cfg.ntfyTopic } }];\n"
      },
      "id": "db9a9b36-b547-532a-b506-1931112d04d9",
      "name": "Zuweisung pruefen",
      "type": "n8n-nodes-base.code",
