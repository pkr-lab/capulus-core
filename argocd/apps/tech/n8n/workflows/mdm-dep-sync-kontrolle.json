    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const unassigned = (devices) => devices\n  .filter((device) => device.op_type !== 'deleted')\n  .filter((device) => !device.profile_uuid || device.profile_status === 'empty')\n  .map((device) => device.serial_number);\nconst cfg = $('Konfiguration').first().json;\nconst all = $('Alle Geraete abrufen').first().json;\nconst assigner = $input.first().json;\nconst list = (all.body && all.body.devices) || [];\nreturn [{ json: { source: 'Tageskontrolle', unassigned: unassigned(list), detailStatus: all.statusCode, assignerMissing: !(assigner.statusCode === 200 && assigner.body && assigner.body.profile_uuid), ntfyUrl: cfg.ntfyUrl, ntfyTopic: cfg.ntfyTopic } }];\n"
      },
      "id": "4af70ff6-cb35-56a7-b4f7-895ba922ca1f",
      "name": "Tageskontrolle auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nconst lines = [];\nif (row.detailStatus !== 200) lines.push('Abruf bei Apple fehlgeschlagen (HTTP ' + row.detailStatus + '). Ist der DEP-Token noch gueltig?');\nif (row.assignerMissing) lines.push('Es ist kein DEP-Profil als Assigner gesetzt, neue Geraete bekommen kein Enrollment-Profil. Abhilfe: scripts/mdm-dep-profile.sh oder das Verlaengerungs-Formular.');\nif (row.unassigned.length > 0) lines.push('Ohne DEP-Profil (' + row.unassigned.length + '): ' + row.unassigned.join(', '));\nif (lines.length === 0) return [];\nreturn [{ json: { title: 'MDM: DEP-Zuweisung pruefen (' + row.source + ')', message: lines.join('\\n'), ntfyUrl: row.ntfyUrl, ntfyTopic: row.ntfyTopic } }];\n"
      },
      "id": "df0e38cd-6d25-5757-ba33-2ef1415f2469",
      "name": "Meldung bauen",
