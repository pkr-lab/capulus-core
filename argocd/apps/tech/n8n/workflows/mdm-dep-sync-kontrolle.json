      "id": "daf27081-1495-5dd8-abbc-b3a4c38f0944",
      "name": "Konfiguration Sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('DEP-Sync').first().json.body || {};\nconst response = (body.device_response_event || {}).device_response || {};\nconst serials = (response.devices || [])\n  .filter((device) => device.op_type === 'added' || device.op_type === 'modified')\n  .map((device) => device.serial_number)\n  .filter(Boolean);\nif (serials.length === 0) return [];\nreturn [{ json: { serials } }];\n"
      },
      "id": "faaa8c73-4a88-51e3-8240-fc80752e7034",
      "name": "Neue Geraete aus Sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        160
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "minutes"
      },
      "id": "b1f1520f-e101-5bbf-9d2c-c3f5b46df852",
      "name": "Zwei Minuten warten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
