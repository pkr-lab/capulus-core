        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ devices: $('Neue Geraete aus Sync').first().json.serials }) }}",
        "options": {
