      "id": "67ef6235-db91-53b3-8896-527397cdf605",
      "name": "Befehle vorhanden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('Konfiguration').first().json.nanomdmUrl }}/v1/enqueue/{{ $json.enrollment_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/xml",
        "body": "={{ $json.plist }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "7a43db59-58f1-519e-b2d3-7b787de0ca88",
      "name": "InstallProfile einreihen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        120
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM NanoMDM API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sent = $('Befehle bauen').all().map((item) => item.json).filter((row) => !row.skip);\nreturn $input.all().map((response, index) => {\n  const source = sent[index];\n  const body = response.json.body || {};\n  const queued = body.command_uuid === source.command_uuid;\n  const results = Object.values(body.status || {});\n  const pushError = results.map((entry) => entry.push_error).filter(Boolean).join('; ');\n  const detail = queued ? pushError : String(response.json.statusCode || response.json.error || 'keine Antwort');\n  return { json: { enrollment_id: source.enrollment_id, profile_name: source.profile_name, command_uuid: source.command_uuid, ok: queued ? 'yes' : 'no', detail } };\n});\n"
      },
      "id": "86048374-1cbe-5a28-9c95-dade172cb3b4",
      "name": "Ergebnis auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE automation.device_profile\nSET state = CASE WHEN $4 = 'yes' THEN 'queued' ELSE 'failed' END,\n    command_uuid = CASE WHEN $4 = 'yes' THEN $3 ELSE NULL END,\n    sent_at = now()\nWHERE enrollment_id = $1 AND profile_name = $2\nRETURNING enrollment_id, profile_name, state, $5::text AS detail",
        "options": {
          "queryReplacement": "={{ [$json.enrollment_id, $json.profile_name, $json.command_uuid, $json.ok, $json.detail] }}"
        }
      },
      "id": "80a7d4a0-6946-51e3-8762-5320e0c079ad",
      "name": "Status vermerken",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2240,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM Automation DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.version,\n       count(*) FILTER (WHERE d.state = 'queued') AS queued,\n       count(*) FILTER (WHERE d.state = 'installed') AS installed,\n       count(*) FILTER (WHERE d.state IN ('failed', 'error')) AS failed,\n       (SELECT count(*) FROM public.enrollments WHERE type = 'Device' AND enabled) AS devices\nFROM automation.profile_state p\nLEFT JOIN automation.device_profile d ON d.profile_name = p.name AND d.version = p.version\nWHERE p.name = 'lockscreen'\nGROUP BY p.version",
        "options": {}
      },
      "id": "3df97151-9d0e-544d-a132-3afd70b8c5bd",
      "name": "Ergebnis auslesen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2480,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM Automation DB"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nconst queued = Number(row.queued || 0) + Number(row.installed || 0);\nconst failed = Number(row.failed || 0);\nconst devices = Number(row.devices || 0);\nconst message = 'Lock-Screen-Profil Version ' + row.version + ': ' + queued + ' von ' + devices + ' Geraeten eingereiht, ' + failed + ' fehlgeschlagen. Quittungen der Geraete werden automatisch vermerkt.';\nreturn [{ json: { message, failed, title: failed > 0 ? 'MDM: Lock-Screen mit Fehlern ausgerollt' : 'MDM: Lock-Screen ausgerollt' } }];\n"
      },
      "id": "455df883-8ac5-50e9-9018-8babd8d3b7aa",
      "name": "Meldung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
