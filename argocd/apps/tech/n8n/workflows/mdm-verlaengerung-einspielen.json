    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const put = $('DEP-Token einspielen').first().json;\nif (put.statusCode !== 200) {\n  return [{ json: { title: 'DEP-Token nicht eingespielt', message: 'NanoDEP antwortete mit HTTP ' + (put.statusCode || put.error) + ': ' + JSON.stringify(put.body || {}) + '\\nBei einem neuen MDM-Server in Apple Business die Option \\\"Pruefung ueberspringen\\\" waehlen.', priority: 'high', tags: 'x', needsProfile: false } }];\n}\nconst tokens = $('DEP-Ablauf lesen').first().json;\nconst account = $('DEP-Konto lesen').first().json;\nconst assigner = $('Assigner lesen').first().json;\nconst expiry = tokens.body && tokens.body.access_token_expiry ? String(tokens.body.access_token_expiry).slice(0, 10) : 'unbekannt';\nconst accountOk = account.statusCode === 200 && account.body;\nconst assignerSet = assigner.statusCode === 200 && assigner.body && assigner.body.profile_uuid;\nconst lines = ['Neues Ablaufdatum: ' + expiry + '.'];\nlines.push(accountOk ? 'Apple Business antwortet: ' + (account.body.server_name || '') + ' (' + (account.body.org_name || '') + ').' : 'Achtung: Der Konto-Abruf bei Apple schlug fehl (HTTP ' + (account.statusCode || account.error) + ').');\nreturn [{ json: { title: accountOk ? 'DEP-Token erneuert' : 'DEP-Token eingespielt, Apple-Abruf fehlgeschlagen', message: lines.join(' '), priority: accountOk ? 'default' : 'high', tags: accountOk ? 'white_check_mark' : 'warning', needsProfile: accountOk && !assignerSet } }];\n"
      },
