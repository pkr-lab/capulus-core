      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { X509Certificate } = require('crypto');\nconst put = $('Push-Zertifikat einspielen').first().json;\nif (put.statusCode !== 200) {\n  return [{ json: { title: 'Push-Zertifikat nicht eingespielt', message: 'NanoMDM antwortete mit HTTP ' + (put.statusCode || put.error) + ': ' + JSON.stringify(put.body || {}), priority: 'high', tags: 'x' } }];\n}\nconst stored = $input.first().json;\nconst cert = new X509Certificate(stored.cert_pem);\nconst days = Math.floor((new Date(cert.validTo).getTime() - Date.now()) / 86400000);\nconst expiry = new Date(cert.validTo).toISOString().slice(0, 10);\nreturn [{ json: { title: 'Push-Zertifikat erneuert', message: 'Topic ' + stored.topic + '. Neues Ablaufdatum: ' + expiry + ' (' + days + ' Tage).', priority: 'default', tags: 'white_check_mark' } }];\n"
      },
