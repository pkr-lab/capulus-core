    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $('Formular Verlaengerung').first();\nconst kind = String(item.json['Was wird eingespielt?'] || '');\nconst names = Object.keys(item.binary || {});\nconst existingTopic = $('Vorhandenes Topic lesen').first().json.topic || '';\nconst result = { existing_topic: existingTopic, kind: kind.indexOf('Push') === 0 ? 'apns' : 'dep', force: kind.indexOf('neuen MDM-Server') !== -1 ? '1' : '0' };\nif (names.length === 0) {\n  return [{ json: { ok: false, title: 'Keine Datei hochgeladen', message: 'Bitte die Datei aus dem Apple-Portal hochladen.', priority: 'default', tags: 'warning' } }];\n}\nif (result.kind === 'apns' && names.length < 2) {\n  return [{ json: { ok: false, title: 'Privater Schluessel fehlt', message: 'Fuer das Push-Zertifikat werden push.pem UND push.key benoetigt.', priority: 'default', tags: 'warning' } }];\n}\nconst binary = { cert: item.binary[names[0]] };\nif (result.kind === 'apns') binary.key = item.binary[names[1]];\nreturn [{ json: Object.assign({ ok: true }, result), binary }];\n"
      },
