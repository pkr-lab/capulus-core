      "id": "d0b70111-e0cd-51c8-a266-bf8d7fc27c97",
      "name": "Vorhandenes Topic lesen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM Automation DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { X509Certificate, createPrivateKey, createPublicKey } = require('crypto');\nconst fail = (message) => [{ json: { ok: false, title: 'Push-Zertifikat abgelehnt', message, priority: 'high', tags: 'x' } }];\nconst certText = (await this.helpers.getBinaryDataBuffer(0, 'cert')).toString('utf8');\nconst keyText = (await this.helpers.getBinaryDataBuffer(0, 'key')).toString('utf8');\nif (/ENCRYPTED/.test(keyText)) return fail('Der private Schluessel ist passwortgeschuetzt. NanoMDM braucht einen unverschluesselten Schluessel (push.key aus mdm-apns.sh).');\nlet cert;\nlet privateKey;\ntry {\n  cert = new X509Certificate(certText);\n} catch (e) {\n  return fail('Die erste Datei ist kein gueltiges PEM-Zertifikat: ' + e.message);\n}\ntry {\n  privateKey = createPrivateKey(keyText);\n} catch (e) {\n  return fail('Die zweite Datei ist kein gueltiger privater Schluessel: ' + e.message);\n}\nconst spki = (key) => key.export({ type: 'spki', format: 'der' }).toString('base64');\nif (spki(createPublicKey(privateKey)) !== spki(cert.publicKey)) {\n  return fail('Zertifikat und privater Schluessel gehoeren nicht zusammen. Es muss der push.key aus derselben Anfrage (mdm-apns.sh request) sein.');\n}\nconst match = /UID=(com\\.apple\\.mgmt\\.External\\.[0-9a-fA-F-]+)/.exec(cert.subject);\nif (!match) return fail('Im Zertifikat steht kein MDM-Push-Topic (UID=com.apple.mgmt.External...). Das ist kein Apple-MDM-Push-Zertifikat.');\nconst topic = match[1];\nconst existing = $input.first().json.existing_topic;\nif (existing && existing !== topic) {\n  return fail('Das Topic ' + topic + ' weicht vom aktuellen Topic ' + existing + ' ab. Bei Apple muss \\\"Renew\\\" benutzt werden, sonst muessen alle iPads neu enrollt werden. Nichts wurde geaendert.');\n}\nconst days = Math.floor((new Date(cert.validTo).getTime() - Date.now()) / 86400000);\nif (days < 300) return fail('Das Zertifikat ist nur noch ' + days + ' Tage gueltig. Es wurde vermutlich das alte Zertifikat hochgeladen. Nichts wurde geaendert.');\nconst body = await this.helpers.prepareBinaryData(Buffer.from(certText.trim() + '\\n' + keyText.trim() + '\\n', 'utf8'), 'push.pem', 'application/x-pem-file');\nreturn [{ json: { ok: true, topic, days }, binary: { body } }];\n"
      },
