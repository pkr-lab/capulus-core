        "jsCode": "const base = $('DEP-Ergebnis').first().json;\nconst profile = $('DEP-Profil definieren').first().json;\nconst assigner = $('Assigner setzen').first().json;\nconst uuid = profile.body && profile.body.profile_uuid;\nif (profile.statusCode !== 200 || !uuid) {\n  return [{ json: { title: 'DEP-Token erneuert, Profil fehlt', message: base.message + ' Das DEP-Enrollment-Profil konnte nicht angelegt werden (HTTP ' + (profile.statusCode || profile.error) + '): ' + JSON.stringify(profile.body || {}) + '. Manuell: scripts/mdm-dep-profile.sh', priority: 'high', tags: 'warning' } }];\n}\nif (assigner.statusCode !== 200) {\n  return [{ json: { title: 'DEP-Token erneuert, Assigner fehlt', message: base.message + ' Profil ' + uuid + ' wurde angelegt, der Assigner konnte nicht gesetzt werden (HTTP ' + (assigner.statusCode || assigner.error) + ').', priority: 'high', tags: 'warning' } }];\n}\nreturn [{ json: { title: base.title, message: base.message + ' DEP-Enrollment-Profil ' + uuid + ' wurde angelegt und als Assigner gesetzt.', priority: 'default', tags: 'white_check_mark' } }];\n"
      },
