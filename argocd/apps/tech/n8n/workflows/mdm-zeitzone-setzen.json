      "id": "c6ecfaa5-4de4-5c41-81a6-ea5f5709d7a7",
      "name": "Eingabe gueltig?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst cfg = {\n  nanomdmUrl: 'http://mdm-nanomdm.mdm.svc.cluster.local:9000',\n  ntfyUrl: 'http://ntfy.ntfy.svc.cluster.local',\n  ntfyTopic: 'Home-Lab-MDM',\n  timeZone: 'Europe/Berlin',\n  mode: input.mode,\n  serial: input.serial || ''\n};\nreturn [{ json: cfg }];\n"
      },
      "id": "24a20732-6ea8-5b29-8c55-65c4f0ceb873",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.id AS enrollment_id, d.serial_number FROM public.enrollments e JOIN public.devices d ON d.id = e.device_id WHERE e.type = 'Device' AND e.enabled AND ($1::text = '' OR d.serial_number = $1::text) AND ($2::text = 'manual' OR NOT EXISTS (SELECT 1 FROM automation.setting s WHERE s.key = 'zeitzone:' || e.id AND s.value = $3::text)) ORDER BY d.serial_number",
        "options": {
          "queryReplacement": "={{ [$('Konfiguration').first().json.serial, $('Konfiguration').first().json.mode, $('Konfiguration').first().json.timeZone] }}"
        }
      },
      "id": "34a48b53-5cd5-5bbb-8275-2f3e8afee4b6",
      "name": "Geraete suchen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        920,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM Automation DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst cfg = $('Konfiguration').first().json;\nconst rows = $input.all().map((item) => item.json).filter((row) => row.enrollment_id);\nif (rows.length === 0) return [{ json: { skip: true } }];\nreturn rows.map((row) => {\n  const commandUuid = crypto.randomUUID();\n  const plist = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n'\n    + '<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\\n'\n    + '<plist version=\"1.0\">\\n<dict>\\n\\t<key>Command</key>\\n\\t<dict>\\n\\t\\t<key>RequestType</key>\\n\\t\\t<string>Settings</string>\\n'\n    + '\\t\\t<key>Settings</key>\\n\\t\\t<array>\\n\\t\\t\\t<dict>\\n\\t\\t\\t\\t<key>Item</key>\\n\\t\\t\\t\\t<string>TimeZone</string>\\n'\n    + '\\t\\t\\t\\t<key>TimeZone</key>\\n\\t\\t\\t\\t<string>' + cfg.timeZone + '</string>\\n\\t\\t\\t</dict>\\n\\t\\t</array>\\n'\n    + '\\t</dict>\\n\\t<key>CommandUUID</key>\\n\\t<string>' + commandUuid + '</string>\\n</dict>\\n</plist>\\n';\n  return { json: { skip: false, enrollment_id: row.enrollment_id, serial_number: row.serial_number, command_uuid: commandUuid, plist } };\n});\n"
      },
      "id": "dadb63ba-e23a-5ea3-b921-62a6f1c3600b",
      "name": "Befehle bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip !== true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "95de8038-aba1-5351-ae8a-07f1ff1ce367"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
