    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $('Formular Zeitzone').first().json;\nconst serial = String(input['Seriennummer (leer = alle iPads)'] || '').trim();\nif (serial.length > 40 || !/^[A-Za-z0-9]*$/.test(serial)) {\n  return [{ json: { ok: false, mode: 'manual', title: 'Nichts gesendet', message: 'Die Seriennummer darf nur Buchstaben und Ziffern enthalten.' } }];\n}\nreturn [{ json: { ok: true, mode: 'manual', serial } }];\n"
      },
      "id": "187e42f0-48c5-5c45-a9ca-f7fb03b1da39",
      "name": "Eingabe pruefen",
      "type": "n8n-nodes-base.code",
