    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('Konfiguration').first().json.nanomdmUrl }}/v1/enqueue/{{ $json.enrollment_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/xml",
        "body": "={{ $json.plist }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "1ed9b0f3-9167-5088-8f13-f192bead7a8b",
      "name": "Zeitzone einreihen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1610,
        200
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM NanoMDM API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sent = $('Befehle bauen').all().map((item) => item.json).filter((row) => !row.skip);\nreturn $input.all().map((response, index) => {\n  const source = sent[index];\n  const body = response.json.body || {};\n  const queued = body.command_uuid === source.command_uuid;\n  const results = Object.values(body.status || {});\n  const pushError = results.map((entry) => entry.push_error).filter(Boolean).join('; ');\n  const detail = queued ? pushError : String(response.json.statusCode || response.json.error || 'keine Antwort');\n  return { json: { enrollment_id: source.enrollment_id, serial_number: source.serial_number, command_uuid: source.command_uuid, ok: queued ? 'yes' : 'no', detail } };\n});\n"
      },
      "id": "abc4f84f-af36-5978-802d-e20d140e238d",
      "name": "Ergebnis auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH marked AS (\n  INSERT INTO automation.setting (key, value)\n  SELECT 'zeitzone:' || $1::text, $5::text WHERE $4::text = 'yes'\n  ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now()\n  RETURNING key\n)\nSELECT $1::text AS enrollment_id, $2::text AS serial_number, CASE WHEN $4::text = 'yes' THEN 'queued' ELSE 'failed' END AS state, $3::text AS command_uuid",
        "options": {
          "queryReplacement": "={{ [$json.enrollment_id, $json.serial_number, $json.command_uuid, $json.ok, $('Konfiguration').first().json.timeZone] }}"
        }
      },
      "id": "6f4d9c72-a5a9-5af3-90c7-d39d49f5c49f",
      "name": "Status vermerken",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2070,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME_NACH_IMPORT",
          "name": "MDM Automation DB"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Konfiguration').first().json;\nconst rows = $input.all().map((item) => item.json).filter((row) => row.enrollment_id);\nconst failed = rows.filter((row) => row.state === 'failed');\nconst names = rows.map((row) => row.serial_number || row.enrollment_id).join(', ');\nconst text = 'Zeitzone ' + cfg.timeZone + ' (Berlin, Deutschland): ' + (rows.length - failed.length) + ' von ' + rows.length + ' iPad(s) haben den Befehl erhalten' + (failed.length > 0 ? ', ' + failed.length + ' fehlgeschlagen' : '') + ' (' + names + '). Das wirkt nur auf beaufsichtigten iPads; die Zeitzone ist danach nicht mehr automatisch.';\nconst auto = cfg.mode === 'auto';\nreturn [{ json: { silent: auto && failed.length === 0, title: failed.length > 0 ? 'Zeitzone mit Fehlern gesendet' : 'Zeitzone gesendet', message: text, priority: failed.length > 0 ? 'high' : 'default' } }];\n"
      },
