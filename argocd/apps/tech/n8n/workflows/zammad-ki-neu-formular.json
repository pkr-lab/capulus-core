      "name": "Ticketnummern prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "jsCode": "// Erlaubt Trennung mit Komma, Leerzeichen oder Zeilenumbruch und ein führendes #.\nconst roh = String($json['Ticketnummern'] || '');\nconst nummern = [...new Set(roh.split(/[^0-9]+/).filter((n) => n.length >= 3 && n.length <= 12))].slice(0, 20);\nreturn [{ json: { tickets: nummern.join(','), anzahl: nummern.length } }];"
      }
    },
