    {
      "parameters": {
        "method": "POST",
        "url": "http://ntfy.ntfy.svc.cluster.local/zammad",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Title",
              "value": "KI-Entwurf wartet auf Freigabe"
            },
            {
