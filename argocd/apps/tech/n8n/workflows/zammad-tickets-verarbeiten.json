      "id": "c5e4eb31-3605-4f4b-8bd4-a7bccd236ba8",
      "name": "Ticket-Artikel laden",
      "type": "n8n-nodes-base.zammad",
      "typeVersion": 1,
      "position": [
        7056,
        80
      ],
      "credentials": {
        "zammadBasicAuthApi": {
          "id": "0M2CPfsvNq5Xdzfc",
          "name": "Zammad ticket.emue365"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// \"Ticket-Artikel laden\" (Zammad Ticket:Get) liefert das Ticket-Objekt UND haengt\n// zusaetzlich ein \"articles\"-Array mit dem Artikel-Verlauf an (der native Node\n// ruft dafuer intern zusaetzlich /ticket_articles/by_ticket/:id auf).\nconst { articles, ...ticket } = $input.first().json;\n\nfunction stripHtml(html) {\n  return String(html || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nconst verlauf = (articles || [])\n  .map((a) => `[${a.from || 'unbekannt'}]: ${stripHtml(a.body)}`)\n  .join('\\n\\n');\n\nconst prompt = [\n  'Du bist Support-Assistent und entwirfst NUR einen Antwortvorschlag -- er wird von einem Menschen geprueft, bevor er verschickt wird.',\n  `Ticket-Titel: ${ticket.title}`,\n  '',\n  'Bisheriger Verlauf:',\n  verlauf,\n  '',\n  'Formuliere einen hoeflichen, knappen Antwortentwurf auf Deutsch. Wenn dir Informationen fehlen, formuliere stattdessen Rueckfragen statt zu raten.',\n].join('\\n');\n\nreturn [{ json: { ticket, prompt } }];"
      },
      "id": "f3e42360-961f-47ed-ba71-de4c541ba7e7",
      "name": "LLM-Prompt bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7328,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama.ollama.svc.cluster.local:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3.2:3b', prompt: $json.prompt, stream: false }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "8ac92ba5-18e4-4b86-a6a2-b555b9f71a3e",
      "name": "LLM-Anfrage (Ollama, lokal)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        7584,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ollama /api/generate liefert mit stream:false ein einzelnes JSON-Objekt\n// mit dem fertigen Text im Feld \"response\" (siehe https://github.com/ollama/ollama/blob/main/docs/api.md#generate-a-completion).\nconst ticket = $('LLM-Prompt bauen').item.json.ticket;\nconst entwurf = $json.response || JSON.stringify($json);\n\nreturn [{ json: { ticket, entwurf } }];"
      },
      "id": "f032ec39-7f4e-42dd-9446-cdebfd0d9460",
      "name": "Antwortentwurf extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7840,
        80
      ]
    },
    {
      "parameters": {
        "authentication": "basicAuth",
        "resource": "ticket",
        "operation": "update",
        "id": "={{ $json.ticket.id }}",
        "updateFields": {
          "state_id": 6,
          "pending_time": "={{ $now.plus({ days: 3 }).toUTC().toISO() }}",
          "note": "={{ $json.entwurf }}"
        }
      },
      "id": "220debca-afc9-409b-b576-9b6aa91c3f39",
      "name": "Entwurf als interne Notiz speichern + Status setzen",
      "type": "n8n-nodes-base.zammad",
      "typeVersion": 1,
      "position": [
        8096,
        80
      ],
      "credentials": {
        "zammadBasicAuthApi": {
          "id": "0M2CPfsvNq5Xdzfc",
          "name": "Zammad ticket.emue365"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Laeuft IMMER genau einmal, unabhaengig davon, ob 0 oder mehrere Tickets\n// gefunden/verarbeitet wurden -- \"Run Once for All Items\" ignoriert die\n// tatsaechliche Item-Anzahl. Zusaetzlich direkt vom Trigger-Node gespeist\n// (siehe connections unten), damit dieser Node auch dann feuert, wenn der\n// Ticket-Zweig oben komplett leer durchlaeuft. Der Haupt-Workflow verlaesst\n// sich auf genau dieses eine Rueckgabe-Item, um zuverlaessig weiterzulaufen\n// (Ollama wieder herunterskalieren).\n//\n// $input.all() zaehlt IMMER die direkte Trigger-Passthrough-Item (+1) MIT,\n// unabhaengig davon wie viele echte Tickets den Ticket-Zweig durchlaufen haben\n// -- ungefixt meldet dieser Node faelschlich '1 verarbeitet' bei 0 echten\n// Tickets (gefunden am 27.08.2026: IF-Node liess 0 von 123 offenen Tickets\n// durch, Ticket-Artikel laden/LLM/Notiz/ntfy liefen nie, trotzdem stand\n// verarbeiteteTickets:1 im Ergebnis). Die Passthrough-Item ist strukturell\n// immer genau 1, daher hier abgezogen.\nreturn [{ json: { status: 'done', verarbeiteteTickets: Math.max($input.all().length - 1, 0) } }];"
      },
      "id": "5ffdf2c9-b4c1-48e5-8041-6194fd8035ac",
      "name": "Abschluss (immer genau 1 Item)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8592,
        320
      ]
    },
