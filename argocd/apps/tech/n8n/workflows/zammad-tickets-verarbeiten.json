    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ticket = $('LLM-Eingabe bauen').item.json.ticket;\n\nlet parsed = null;\ntry {\n  parsed = JSON.parse(String($json.stdout || '').trim().split('\\n').pop());\n} catch (err) {\n  parsed = null;\n}\n\nif (!parsed || !parsed.ok) {\n  const detail = parsed && parsed.error\n    ? `${parsed.error.code}: ${parsed.error.message}`\n    : String($json.stderr || 'keine Ausgabe von ollama-pc/cli.js').trim();\n  throw new Error(`Ollama-Anfrage fehlgeschlagen (Ticket #${ticket.number}): ${detail}`);\n}\n\nreturn { json: { ticket, entwurf: parsed.reply, warnings: parsed.warnings, stats: parsed.stats } };"
      },
