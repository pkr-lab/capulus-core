# Generated by `xcodegen generate` from project.yml — project.yml is the
# source of truth, the .xcodeproj itself isn't committed (same reasoning as
# not committing rendered Helm templates: regenerate, don't hand-edit/merge).
*.xcodeproj/
DerivedData/
.build/
*.xcuserstate
xcuserdata/
.swiftpm/

# Also generated by `xcodegen generate`, from project.yml's info.properties
# — XcodeGen overwrites this file unconditionally on every generate, so a
# committed copy would just be stale/misleading, same reasoning as the
# .xcodeproj above.
HomeserverDashboard/Info.plist
