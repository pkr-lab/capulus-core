<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pure iOS app, no CarPlay entitlement needed. Kept as an empty
	     entitlements file (rather than removing it) since project.yml
	     already references this path and Xcode expects the file to exist
	     once a target declares an entitlements file. -->
</dict>
</plist>
