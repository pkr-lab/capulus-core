{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "feat(deps):",
  "helm-values": {
    "fileMatch": ["^argocd/apps/.+/values\\.yaml$"]
  },
  "helmv3": {
    "fileMatch": ["^argocd/apps/.+/Chart\\.yaml$"]
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Vendored/pulled-in subcharts (Chart.lock, charts/*.tgz) are refreshed manually via `helm dependency update`, not by Renovate opening PRs against generated lockfiles.",
      "matchFileNames": ["**/charts/**", "**/Chart.lock"],
      "enabled": false
    },
    {
      "description": "Group all Helm chart + image tag bumps for a single app into one PR instead of one PR per field.",
      "matchFileNames": ["argocd/apps/**"],
      "groupName": "{{packageFileDir}}"
    },
    {
      "description": "Security patch releases land immediately, not on the weekly schedule.",
      "matchUpdateTypes": ["patch"],
      "schedule": ["at any time"]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0
}
